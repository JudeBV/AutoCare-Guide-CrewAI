# AutoCare Guide CrewAI Backend Environment Configuration
# Copy this file to .env and set your LLM API key before running live AI responses.

# Option 1: OpenAI API Key (Recommended)
OPENAI_API_KEY=your_openai_api_key_here

# Option 2: Gemini API Key (Alternative)
GEMINI_API_KEY=your_gemini_api_key_here

# CORS Configuration for Frontend Integration
CORS_ORIGINS=http://localhost:4200
